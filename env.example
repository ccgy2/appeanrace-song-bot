# Copy to .env for local use; set the same names in your hosting Variables page.
# Never upload the real .env, Discord token, or Firebase service-account key.
DISCORD_TOKEN=
OWNER_ID=0

# Required to preserve the existing Firebase data: keep your OLD value here.
# Accepts the original service-account JSON string or a local JSON file path.
# Leave empty ONLY when intentionally starting a new local SQLite database.
FIREBASE_SERVICE_ACCOUNT=

# Change this placeholder to a unique password of at least 12 characters.
WEB_ADMIN_PASSWORD=CHANGE_ME_TO_A_RANDOM_LONG_PASSWORD
WEB_ENABLED=true
WEB_ONLY=false
HOST=0.0.0.0
PORT=8080
# Local use: leave empty. Hosting: https://your-domain (NO trailing path).
PUBLIC_URL=
# Automatically true for an HTTPS PUBLIC_URL. Usually do not set manually.
# WEB_COOKIE_SECURE=true

# Local default: ./data. Railway volume example: DATA_DIR=/data
# DATA_DIR=/data
MAX_UPLOAD_MB=25
MAX_STORAGE_MB=1024
VOICE_IDLE_SECONDS=300
ENABLE_MEMBERS_INTENT=false
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Optional: retain your existing cookie setting only when actually needed.
YTDLP_COOKIES_PATH=
YTDLP_COOKIES_B64=
