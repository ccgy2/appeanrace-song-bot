# Railway / local configuration
DISCORD_TOKEN=
DISCORD_TOKEN_SECONDARY=
OWNER_ID=0
WEB_ADMIN_PASSWORD=CHANGE_ME_TO_A_RANDOM_LONG_PASSWORD

# Firebase/Firestore를 사용하지 않는 기본값. 기존 FIREBASE_SERVICE_ACCOUNT가 Railway에 남아 있어도 무시됩니다.
STORAGE_BACKEND=sqlite
# FIREBASE_SERVICE_ACCOUNT=  # 과거 데이터 마이그레이션 때만 사용
# MIGRATE_FIRESTORE_ONCE=false

WEB_ENABLED=true
WEB_ONLY=false
HOST=0.0.0.0
PORT=8080
DATA_DIR=/data
MAX_UPLOAD_MB=10240
MAX_STORAGE_MB=20480
VOICE_IDLE_SECONDS=300
ENABLE_MEMBERS_INTENT=false
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
YTDLP_COOKIES_PATH=
YTDLP_COOKIES_B64=
PRIMARY_BOT_LABEL=청팀 봇
SECONDARY_BOT_LABEL=백팀 봇

# Resource-saving defaults; existing Railway Variables can stay as they are.
YTDLP_CACHE_SECONDS=600
YTDLP_CACHE_ENTRIES=32
YTDLP_MAX_CONCURRENT=1
FFMPEG_THREADS=1

# Railway Docker defaults to economy: 96 kbps without in-band FEC.
# Use standard for the original 128 kbps/FEC behavior on unstable networks.
AUDIO_PROFILE=economy
